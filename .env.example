# Gekaixing environment template
# Copy to `.env.development.local` / `.env.production.local` and fill in real values.
# Keep this file free of secrets — it is committed to the repo.

# --- Database (Prisma) ---
# Connection pooler (PgBouncer) for the app runtime.
DATABASE_URL="postgresql://<user>:<password>@<host>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection for `prisma migrate` / CLI.
DIRECT_URL="postgresql://<user>:<password>@<host>.pooler.supabase.com:5432/postgres"

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# server.ts / proxy.ts read this one
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"
# client.ts reads this one (same value; keep both in sync)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="<publishable-key>"
# Server-only. Never prefix this with NEXT_PUBLIC_ (it bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY="<service-role-jwt>"

# --- App URLs ---
NEXT_PUBLIC_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Notion ---
NOTION_TOKEN=""
NOTION_DATABASE_ID=""

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."          # server-only
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."        # server-only

# --- Upstash Redis (server-only) ---
UPSTASH_REDIS_REST_URL="https://<name>.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""

# --- LiveKit Cloud WebRTC ---
NEXT_PUBLIC_LIVEKIT_URL="wss://<project>.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
