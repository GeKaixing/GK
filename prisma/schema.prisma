generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  name                     String?
  avatar                   String?
  backgroundImage          String?
  briefIntroduction        String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  userid                   String                    @unique @default(uuid())
  isPremium                Boolean                   @default(false)
  stripeCustomerId         String?                   @unique
  stripeSubId              String?                   @unique
  subscriptionStatus       SubscriptionStatus        @default(FREE)
  premiumExpiresAt         DateTime?
  premiumGraceEndsAt       DateTime?
  stripePriceId            String?
  role                     UserRole                  @default(STANDARD)
  bookmarks                Bookmark[]
  conversationParticipants ConversationParticipant[]
  conversationReads        ConversationRead[]
  following                Follow[]                  @relation("Following")
  followers                Follow[]                  @relation("Followers")
  likes                    Like[]
  messages                 Message[]                 @relation("SentMessages")
  posts                    Post[]
  shares                   Share[]
  actions                  UserAction[]
  jobPosts                 JobPosting[]
  sponsoredAds             SponsoredAd[]
  assignedWorkTasks        WorkTask[]   @relation("AssignedWorkTasks")
  createdWorkTasks         WorkTask[]   @relation("CreatedWorkTasks")
  liveStreams              LiveStream[]
  liveChatMessages         LiveChatMessage[]
  liveFeedback             LiveFeedback[]
  actor                    Actor?                  @relation("UserActor")
}

/// ///////////////////////////////////////////////////
/// ///////////////////////////////////////////////////
model Follow {
  id          String       @id @default(uuid())
  followerId  String
  followingId String
  status      FollowStatus @default(FOLLOWING)
  muted       Boolean      @default(false)
  createdAt   DateTime     @default(now())
  follower    User         @relation("Following", fields: [followerId], references: [id])
  following   User         @relation("Followers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Post {
  id         String       @id @default(cuid())
  content    String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  authorId   String
  parentId   String?
  rootId     String?
  likeCount  Int          @default(0)
  replyCount Int          @default(0)
  shareCount Int          @default(0)
  starCount  Int          @default(0)
  videoUrl   String?
  audioUrl   String?
  visibility PostVisibility @default(PUBLIC) // RFC-005; schema-only in 3.0.0, enforcement deferred
  bookmarks  Bookmark[]
  likes      Like[]
  author     User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent     Post?        @relation("PostToPost", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Post[]       @relation("PostToPost")
  shares     Share[]
  actions    UserAction[]
  sponsoredAd SponsoredAd?

  @@index([parentId])
  @@index([rootId, createdAt])
  @@index([authorId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model Share {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model Conversation {
  id            String                    @id @default(uuid())
  isGroup       Boolean                   @default(false)
  name          String?
  avatar        String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  lastMessage   String?
  lastMessageAt DateTime?
  messageCount  Int                       @default(0)
  participants  ConversationParticipant[]
  readStates    ConversationRead[]
  messages      Message[]
  workTasks     WorkTask[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  role           String       @default("member") // "admin" | "member"
  mutedAt        DateTime?
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String?
  createdAt      DateTime     @default(now())
  type           String       @default("text")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model ConversationRead {
  id                   String       @id @default(uuid())
  conversationId       String
  userId               String
  lastReadMessageCount Int          @default(0)
  updatedAt            DateTime     @updatedAt
  conversation         Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model WorkTask {
  id             String       @id @default(cuid())
  conversationId String
  title          String
  description    String?
  assigneeId     String?
  status         String       @default("planned") // "planned" | "in_progress" | "done"
  startDate      DateTime
  endDate        DateTime
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignee       User?        @relation("AssignedWorkTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy      User         @relation("CreatedWorkTasks", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([conversationId, endDate])
  @@index([conversationId, status])
}

model ChatAISession {
  id        String          @id @default(cuid())
  userId    String
  title     String          @default("新对话")
  tokenUsed Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  ChatAIMessage[]

  @@index([userId])
}

model ChatAIMessage {
  id        String        @id @default(cuid())
  sessionId String
  role      String
  content   String
  tokens    Int           @default(0)
  createdAt DateTime      @default(now())
  session   ChatAISession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// Pi agent session storage: a virtual file system persisted in Postgres.
// `JsonlSessionRepo` (pi-agent-core) writes each session as an append-only
// JSONL "file" through the JsonlSessionRepoFileSystem seam (lib/ai/pi-fs.ts).
model PiSessionFile {
  path      String    @id // absolute virtual path, e.g. /sessions/<userId>/<sessionId>.jsonl
  content   String?   @db.Text // file content (JSONL lines); null for implicit directories
  size      Int       @default(0) // content length in bytes
  mtimeMs   BigInt    @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model JobPosting {
  id             String   @id @default(cuid())
  authorId       String
  title          String
  company        String
  description    String   @default("") @db.Text
  locationType   String
  seniority      String
  employmentType String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, createdAt])
}

model UserAction {
  id             String         @id @default(cuid())
  userId         String
  actionType     UserActionType
  targetPostId   String?
  targetAuthorId String?
  dwellMs        Int?
  metadata       String?
  createdAt      DateTime       @default(now())
  post           Post?          @relation(fields: [targetPostId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, actionType, createdAt])
  @@index([targetAuthorId, createdAt])
  @@index([targetAuthorId, actionType, createdAt])
  @@index([targetPostId, createdAt])
  @@index([actionType, createdAt])
  @@index([createdAt])
}

enum FollowStatus {
  FOLLOWING
  BLOCKED
  REQUESTED
}

enum UserActionType {
  FEED_IMPRESSION
  POST_CREATE
  REPLY_CREATE
  POST_LIKE
  POST_UNLIKE
  POST_BOOKMARK
  POST_UNBOOKMARK
  POST_SHARE
  FOLLOW
  UNFOLLOW
  POST_CLICK
  DWELL
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  GRACE
  EXPIRED
  CANCELED
}

enum UserRole {
  ADMIN
  STANDARD
}

enum AdStatus {
  PENDING_PAYMENT // 已创建，待付款
  PAID            // 已付款，待管理员审核
  ACTIVE          // 投放中（信息流可见）
  PAUSED          // 管理员暂停
  ENDED           // 到期或手动结束
  REJECTED        // 管理员拒绝
  CANCELLED       // 广告主取消（未付款时）
}

// ============ OSP (Open Social Protocol) — RFC-001..016 ============

enum CountryStatus {
  ACTIVE
  SUSPENDED
  DESTROYED
}

enum PassportStatus {
  ACTIVE
  REVOKED
  EXPIRED
  SUSPENDED
  MIGRATED
}

enum CapabilityType {
  CREATE_POST
  SEARCH
  MODERATE
  TRANSLATE
  GENERATE_MEDIA
  EXECUTE_TASK
  ACCESS_MEMORY
}

enum CapabilityState {
  GRANTED
  REVOKED
  EXPIRED
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum OspEventType {
  COUNTRY_BOOTSTRAPPED
  ACTOR_CREATED
  PASSPORT_ISSUED
  PASSPORT_REVOKED
  POST_CREATED
  POST_DELETED
  REPLY_CREATED
  POST_LIKED
  POST_UNLIKED
  POST_BOOKMARKED
  POST_UNBOOKMARKED
  POST_SHARED
  FOLLOWED
  UNFOLLOWED
  MESSAGE_SENT
  CAPABILITY_GRANTED
  CAPABILITY_REVOKED
  ACCOUNT_DELETED
}

model LiveStream {
  id           String   @id @default(cuid())
  authorId     String
  title        String
  description  String?
  category     String?
  status       String   @default("LIVE") // LIVE | SCHEDULED | ENDED
  streamUrl    String?
  thumbnailUrl String?
  viewerCount  Int      @default(0)
  startedAt    DateTime @default(now())
  scheduledAt  DateTime?
  endedAt      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author       User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  chatMessages LiveChatMessage[]
  feedback     LiveFeedback[]

  @@index([authorId])
  @@index([status, startedAt])
}

model LiveChatMessage {
  id        String   @id @default(cuid())
  streamId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  stream LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  author User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([streamId, createdAt])
}

model LiveFeedback {
  id        String   @id @default(cuid())
  userId    String
  streamId  String
  issueType String
  message   String
  createdAt DateTime @default(now())

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stream LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@index([streamId, createdAt])
}

model SponsoredAd {
  id              String    @id @default(cuid())
  postId          String    @unique
  advertiserId    String
  status          AdStatus  @default(PENDING_PAYMENT)
  priceCents      Int
  currency        String    @default("usd")
  durationDays    Int       @default(1) // 投放时长（天），审核通过时起算
  ctaUrl          String?
  ctaLabel        String?
  startsAt        DateTime?
  endsAt          DateTime?
  stripeSessionId String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  post       Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  advertiser User @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  @@index([status, endsAt])
  @@index([advertiserId])
}

// ============ OSP models — the protocol layer ============

/// OSP RFC-002: an independent server/network realm. Gekaixing is Country "gkx".
model Country {
  id                 String        @id // stable slug: "gkx"
  name               String
  publicKey          String // base64 Ed25519 pubkey (derived from OSP_COUNTRY_SECRET)
  federationEndpoint String?
  policy             String?       @db.Text // JSON string (country policy set)
  status             CountryStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  passports          Passport[]
  events             OspEvent[]
}

/// OSP RFC-004: the universal participant primitive. Human or service actor.
/// Actor survives User deletion (userId is SetNull) so the signed ledger stays.
model Actor {
  id           String        @id @default(uuid())
  userId       String?       @unique // 1:1 human actor -> User; SetNull on user delete
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User?         @relation("UserActor", fields: [userId], references: [id], onDelete: SetNull)
  passports    Passport[]
  events       OspEvent[]
  capabilities Capability[]
}

/// OSP RFC-003: universal passport issued by the Country, signed with the Country key.
model Passport {
  id               String         @id @default(uuid())
  countryId        String
  actorId          String
  publicKey        String // base64 Ed25519 actor pubkey
  issuedAt         DateTime       @default(now())
  expiresAt        DateTime?
  status           PassportStatus @default(ACTIVE)
  signature        String // base64 country signature over the canonical passport payload
  migrationHistory String?        @db.Text // JSON array string (RFC-003)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  country          Country        @relation(fields: [countryId], references: [id])
  actor            Actor          @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([countryId, actorId])
  @@index([actorId])
  @@index([status])
}

/// OSP RFC-006: append-only, signed event ledger. Immutable (no cascade from Actor).
/// objectId is a protocol string, deliberately NOT an FK: the ledger survives object deletion.
model OspEvent {
  id         String       @id @default(cuid())
  eventId    String       @unique @default(cuid())
  countryId  String
  actorId    String
  eventType  OspEventType
  objectType String?
  objectId   String?
  seq        Int
  prevHash   String?
  hash       String // sha256 of the canonical payload
  signature  String // base64 country signature
  payload    String?      @db.Text // canonical JSON (replay/verify)
  globalSeq  BigInt       @unique @default(autoincrement())
  createdAt  DateTime     @default(now())
  country    Country      @relation(fields: [countryId], references: [id])
  actor      Actor        @relation(fields: [actorId], references: [id]) // no cascade: ledger is immutable

  @@unique([actorId, seq])
  @@index([actorId, createdAt])
  @@index([eventType])
}

/// OSP RFC-015: what an Actor is allowed to do, separate from identity.
model Capability {
  id             String          @id @default(uuid())
  actorId        String
  capabilityType CapabilityType
  state          CapabilityState @default(GRANTED)
  scope          String?         @db.Text // JSON string: resource/time/country-policy limits
  grantedBy      String? // actorId or "country"
  grantedAt      DateTime        @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  actor          Actor           @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([actorId, capabilityType])
  @@index([actorId])
}

// ============ OSP federation — RFC-009/011 ============

enum RecognitionState {
  UNKNOWN
  RECOGNIZED
  TRUSTED
  RESTRICTED
  BLOCKED
  SUSPENDED
}

enum FedDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum FedInboundStatus {
  RECEIVED
  ADMITTED
  DENIED
  DUPLICATE
  ERROR
}

/// OSP RFC-009/011: a peer Country this instance federates with. The public key
/// is the ONLY thing needed to verify an inbound envelope (signature = auth).
model RemoteCountry {
  id                 String        @id // remote country id
  name               String
  publicKey          String // base64 SPKI
  federationEndpoint String // base URL; delivery posts to ${base}/api/fed/inbox
  status             CountryStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deliveries         FedDelivery[]
  recognitions       Recognition[]
  objects            FedObject[]
  inbound            FedInbox[]
  actors             RemoteActor[]
}

/// OSP RFC-011: directional recognition. v1 records only OUR stance (from=gkx)
/// toward each peer; A recognizing B does not imply B recognizes A.
model Recognition {
  id            String          @id @default(uuid())
  fromCountryId String // always our COUNTRY_ID in v1
  toCountryId   String
  state         RecognitionState @default(UNKNOWN)
  policy        String?         @db.Text // JSON string
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  remoteCountry RemoteCountry   @relation(fields: [toCountryId], references: [id], onDelete: Cascade)

  @@unique([fromCountryId, toCountryId])
  @@index([toCountryId])
}

/// OSP RFC-009: outbound delivery queue. `payload` persists the signed envelope
/// so retries never need to re-read the source content.
model FedDelivery {
  id              String           @id @default(uuid())
  eventId         String
  actorId         String
  targetCountryId String
  payload         String           @db.Text // envelope payload JSON (canonical)
  status          FedDeliveryStatus @default(PENDING)
  attempts        Int              @default(0)
  nextRetryAt     DateTime?
  lastError       String?
  deliveredAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  remoteCountry   RemoteCountry    @relation(fields: [targetCountryId], references: [id], onDelete: Cascade)

  @@unique([eventId, targetCountryId])
  @@index([status, nextRetryAt])
}

/// OSP RFC-009: inbound receipt / audit log. eventId is the idempotency key.
model FedInbox {
  id              String           @id @default(uuid())
  eventId         String           @unique
  sourceCountryId String
  actorId         String
  eventType       OspEventType
  objectType      String?
  objectId        String?
  payload         String           @db.Text // received canonical envelope payload
  signature       String
  status          FedInboundStatus @default(RECEIVED)
  error           String?
  receivedAt      DateTime         @default(now())
  remoteCountry   RemoteCountry    @relation(fields: [sourceCountryId], references: [id], onDelete: Cascade)

  @@index([sourceCountryId, status])
}

/// OSP RFC-009: admitted remote content (the federated surface). Never mixed
/// into the local Post table — content is server-side sanitized on receipt.
model FedObject {
  id              String           @id @default(uuid())
  eventId         String           @unique
  sourceCountryId String
  actorId         String
  objectType      String
  objectId        String
  content         String?          @db.Text // sanitized HTML
  authorName      String?
  authorHandle    String?
  authorAvatar    String?
  parentId        String? // thread parent object id (replies)
  createdAt       DateTime // original timestamp from the sender
  receivedAt      DateTime         @default(now())
  status          FedInboundStatus @default(ADMITTED)
  remoteCountry   RemoteCountry    @relation(fields: [sourceCountryId], references: [id], onDelete: Cascade)

  @@index([sourceCountryId, receivedAt])
}

/// OSP RFC-001/009: cached remote actor identity (for DID resolution).
model RemoteActor {
  id            String        @id @default(uuid())
  countryId     String
  actorId       String
  name          String?
  handle        String?
  avatar        String?
  publicKey     String?
  profile       String?       @db.Text // JSON string
  firstSeenAt   DateTime      @default(now())
  lastSeenAt    DateTime      @updatedAt
  remoteCountry RemoteCountry @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, actorId])
}

// ============ OSP cross-country social graph — RFC-012 ============

/// A LOCAL user following a REMOTE actor. Distinct from the local Follow table.
model RemoteFollow {
  id        String   @id @default(uuid())
  userId    String
  countryId String
  actorId   String
  createdAt DateTime @default(now())

  @@unique([userId, countryId, actorId])
  @@index([userId])
  @@index([countryId, actorId])
}

/// A REMOTE actor following one of OUR users.
model RemoteFollower {
  id            String   @id @default(uuid())
  countryId     String
  actorId       String
  targetUserId  String
  createdAt     DateTime @default(now())

  @@unique([countryId, actorId, targetUserId])
  @@index([targetUserId])
}

/// A LOCAL user liking a REMOTE post.
model RemoteLike {
  id        String   @id @default(uuid())
  userId    String
  countryId String
  actorId   String
  objectId  String // the remote post's id in its source country
  createdAt DateTime @default(now())

  @@unique([userId, countryId, actorId, objectId])
  @@index([objectId])
  @@index([userId])
}

/// A REMOTE actor liking one of OUR posts.
model RemoteLikeInbound {
  id              String   @id @default(uuid())
  sourceCountryId String
  sourceActorId   String
  postId          String // our local Post id
  createdAt       DateTime @default(now())

  @@unique([sourceCountryId, sourceActorId, postId])
  @@index([postId])
}

/// A LOCAL reply Post that responds to a REMOTE post (the local Post has no
/// local parentId; this row links it to the remote parent).
model RemoteReply {
  id           String   @id @default(uuid())
  userId       String
  localPostId  String   @unique // our local Post id
  countryId    String
  actorId      String
  remotePostId String // the remote post being replied to
  createdAt    DateTime @default(now())

  @@index([remotePostId])
}
